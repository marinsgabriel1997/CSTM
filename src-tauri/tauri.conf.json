{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSTM",
  "version": "0.5.0",
  "identifier": "com.gabriel.cstm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CSTM",
        "width": 1000,
        "height": 650,
        "minWidth": 760,
        "minHeight": 480
      },
      {
        "label": "picker",
        "title": "CSTM",
        "url": "picker.html",
        "width": 340,
        "height": 440,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
