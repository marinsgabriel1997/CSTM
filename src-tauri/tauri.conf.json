{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSTM",
  "version": "1.0.0",
  "identifier": "com.gabriel.cstm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CSTM",
        "width": 1000,
        "height": 650,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": false
      },
      {
        "label": "picker",
        "create": false,
        "title": "CSTM",
        "url": "picker.html",
        "width": 420,
        "height": 440,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CSTM",
    "homepage": "https://github.com/marinsgabriel1997/CSTM",
    "copyright": "© 2026 Gabriel de Marins",
    "shortDescription": "CSTM - Clipboard, Snippets & Text Manager",
    "longDescription": "Cadastre textos reutilizáveis em pastas e cole-os em qualquer programa pelo menu flutuante aberto com Alt+Q.",
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
